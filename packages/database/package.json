{
  "name": "@daljir/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./rbac": {
      "types": "./src/rbac.ts",
      "default": "./src/rbac.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate --schema ../../prisma/schema.prisma",
    "migrate": "prisma migrate dev --schema ../../prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "seed": "tsx src/seed.ts",
    "studio": "prisma studio --schema ../../prisma/schema.prisma"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@daljir/types": "workspace:*",
    "@prisma/client": "^6.16.2"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
