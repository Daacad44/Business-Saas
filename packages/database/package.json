{
  "name": "@daljir/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./rbac": {
      "types": "./src/rbac.ts",
      "default": "./src/rbac.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate --schema ../../prisma/schema.prisma",
    "migrate": "prisma migrate dev --schema ../../prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma && tsx src/run-sync-reference.ts",
    "sync-reference": "tsx src/run-sync-reference.ts",
    "seed": "tsx src/seed.ts",
    "seed:demo": "tsx src/seed-demo.ts",
    "studio": "prisma studio --schema ../../prisma/schema.prisma",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@daljir/types": "workspace:*",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "prisma": "^6.19.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
