{
  "name": "daljir-platform",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver",
      "@swc/core",
      "@parcel/watcher"
    ]
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @daljir/web dev",
    "dev:api": "pnpm --filter @daljir/api dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @daljir/database generate",
    "db:migrate": "pnpm --filter @daljir/database migrate",
    "db:migrate:deploy": "pnpm --filter @daljir/database migrate:deploy",
    "db:sync-reference": "pnpm --filter @daljir/database sync-reference",
    "db:seed": "pnpm --filter @daljir/database seed",
    "db:seed:demo": "pnpm --filter @daljir/database seed:demo",
    "db:studio": "pnpm --filter @daljir/database studio",
    "admin:bootstrap": "pnpm --filter @daljir/api admin:bootstrap"
  }
}
