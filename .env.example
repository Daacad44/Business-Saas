NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
API_ORIGIN=http://localhost:4000

# Pooled connection for the app. Direct URL is used for Prisma migrations.
DATABASE_URL=postgresql://daljir:daljir@localhost:5432/daljir
DATABASE_URL_DIRECT=postgresql://daljir:daljir@localhost:5432/daljir

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

COOKIE_DOMAIN=
COOKIE_SECURE=false

INVITATION_TTL_DAYS=7

# Optional: claim URL if using a Neon claimable database
# NEON_CLAIM_URL=

# =====================================================================
# PHASE 5 — AUTOMATION & NOTIFICATIONS (all OPTIONAL; the API and worker
# both boot and run correctly with none of these set, falling back to a
# safe no-op/logging notification driver).
# =====================================================================

# Worker
WORKER_HEALTH_PORT=4100
AUTOMATION_SCAN_INTERVAL_MINUTES=15
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BASE_MS=2000

# WhatsApp Business Cloud API-style provider
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# WHATSAPP_FROM_PHONE_ID=

# Generic SMS gateway provider
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=

# SMTP email provider
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
