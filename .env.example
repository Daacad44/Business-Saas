NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
API_ORIGIN=http://localhost:4000

# Pooled connection for the app. Direct URL is used for Prisma migrations.
DATABASE_URL=postgresql://daljir:daljir@localhost:5432/daljir
DATABASE_URL_DIRECT=postgresql://daljir:daljir@localhost:5432/daljir

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

COOKIE_DOMAIN=
COOKIE_SECURE=false

INVITATION_TTL_DAYS=7

# Optional: claim URL if using a Neon claimable database
# NEON_CLAIM_URL=
